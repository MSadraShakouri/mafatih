{
  "name": "mafatih-content-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "validate": "tsx scripts/validate.ts",
    "audit": "tsx scripts/audit.ts",
    "build:data": "tsx scripts/build-data.ts",
    "build": "npm run validate && npm run build:web",
    "check:repository": "tsx scripts/check-repository.ts",
    "check:line-breaks": "tsx scripts/check-line-breaks.ts",
    "check": "npm run typecheck && npm test && npm run check:repository && npm run check:line-breaks && npm run build",
    "show:item": "tsx scripts/show-item.ts",
    "edit:text": "tsx scripts/edit-text.ts",
    "normalize:punctuation": "tsx scripts/normalize-punctuation.ts",
    "suggest:alignments": "tsx scripts/suggest-alignments.ts",
    "split:plan": "tsx scripts/split-plan.ts",
    "review:html": "tsx scripts/review-page.ts",
    "build:sqlite": "npm run validate && python3 tools/export_sqlite.py",
    "edit:item": "tsx scripts/edit-item.ts",
    "add:item": "tsx scripts/add-item.ts",
    "add:english": "tsx scripts/add-english.ts",
    "edit:english": "tsx scripts/edit-english.ts",
    "check:publication": "tsx scripts/check-publication.ts",
    "build:release": "npm run check:publication && npm run build",
    "alignment:import": "tsx scripts/import-alignments.ts",
    "alignment:manual": "tsx scripts/manual-alignment.ts",
    "stage:web": "tsx scripts/stage-web.ts",
    "prepare:web": "npm run build:data && npm run stage:web",
    "dev": "npm run prepare:web && vite",
    "build:web": "npm run prepare:web && vite build",
    "preview": "vite preview",
    "test:browser": "npm run build && playwright test",
    "test:apk-assets": "python3 -m unittest discover -s tests -p test_verify_apk_assets.py",
    "android:sync": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "7.6.10",
    "@capacitor/core": "7.6.10",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.10",
    "@playwright/test": "1.64.1",
    "@types/node": "20.19.25",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  },
  "allowScripts": {
    "esbuild": true
  }
}
